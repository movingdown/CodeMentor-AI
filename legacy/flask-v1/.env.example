# ─────────────────────────────────────────────────────────────
#  CodeMentor AI 환경변수 템플릿
#  이 파일을 복사해 backend/.env 로 저장한 뒤 값을 채워 넣으세요.
#  ⚠️  실제 .env 는 .gitignore 에 의해 절대 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# === [필수] Gemini API ===
# https://aistudio.google.com/apikey 에서 무료 발급
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 모델. 기본값: gemini-2.5-flash (속도/비용 균형)
# 더 정확한 분석이 필요하면 gemini-2.5-pro 도 가능 (비용 ↑)
GEMINI_MODEL=gemini-2.5-flash

# === [선택] 서버 ===
PORT=5000
FLASK_DEBUG=1

# === [선택] 입력 한도 ===
# 한 번에 분석 가능한 최대 코드 길이(문자 수). 기본 20,000
# 너무 크게 설정하면 토큰 비용이 빠르게 늘어납니다.
MAX_CODE_LENGTH=20000

# === [선택] Rate limit (요청 빈도 제한) ===
# IP당 분석 요청 횟수. ";" 로 복수 규칙 결합 가능
# 기본: 분당 5회, 시간당 30회
RATE_LIMIT=5 per minute;30 per hour

# === [선택] CORS 허용 출처 ===
# 개발 환경: * (모두 허용)
# 배포 환경: 본인 도메인으로 제한 권장 (CSRF 및 API 무단 사용 방지)
# 예) ALLOWED_ORIGINS=https://codementor.example.com,https://www.codementor.example.com
ALLOWED_ORIGINS=*
