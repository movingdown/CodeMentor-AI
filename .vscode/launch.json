{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CodeMentor AI (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "FLASK_DEBUG": "1"
      }
    }
  ]
}
