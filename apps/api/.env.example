APP_ENV=development
LOG_LEVEL=INFO

# === Database (Neon) ===
# Pooled connection 권장. asyncpg는 ?ssl=require (sslmode 아님)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/DBNAME?ssl=require

# === Auth ===
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === Gemini ===
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === GitHub (선택 — public repo는 토큰 없이도 60/hr까지) ===
GITHUB_TOKEN=

# === CORS ===
ALLOWED_ORIGINS=http://localhost:5173
